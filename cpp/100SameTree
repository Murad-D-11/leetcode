/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
class Solution {
public:
    void readTree(TreeNode* root, std::vector<int>& vec) {
        // stops reading the tree further from that point
        if (!root) {
            vec.push_back(100000); // 100000 is out of bounds (i.e. null)
            return;
        }

        // appends the node's value
        vec.push_back(root->val);

        readTree(root->left, vec);
        readTree(root->right, vec);
    }

    bool isSameTree(TreeNode* p, TreeNode* q) {
        std::vector<int> pVec;
        std::vector<int> qVec;

        readTree(p, pVec);
        readTree(q, qVec);

        if (pVec == qVec) return true;
        return false;
    }
};
